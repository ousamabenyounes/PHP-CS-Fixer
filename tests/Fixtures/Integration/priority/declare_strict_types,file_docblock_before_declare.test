--TEST--
Integration of fixers: declare_strict_types,file_docblock_before_declare.
--RULESET--
{"declare_strict_types": true, "file_docblock_before_declare": true}
--EXPECT--
<?php /**
 * Bootstrap for the application.
 */

declare(strict_types=1);

namespace App;

--INPUT--
<?php

/**
 * Bootstrap for the application.
 */

namespace App;
